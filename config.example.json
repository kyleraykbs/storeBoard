{
  "configVersion": 2,
  "root": "/home/alice/Storeboard",
  "dataDir": "/home/alice/.local/share/storeboard",
  "socket": "/run/user/1000/storeboard.sock",
  "peer": "laptop",
  "peers": {
    "laptop": { "endpoints": ["192.168.1.10:4242"] },
    "desktop": { "endpoints": ["192.168.1.11:4242", "[fd00::11]:4242"] },
    "phone": { "endpoints": [] }
  },
  "groups": {
    "family": {
      "peers": ["laptop", "desktop", "phone"],
      "permissions": { "group": "users" }
    },
    "media": {
      "peers": ["laptop", "desktop"]
    }
  },
  "stores": {
    "pictures": {
      "group": "family",
      "symlinks": ["/home/alice/Pictures"],
      "links": { "bulk": "Bulk" }
    },
    "bulk": {
      "group": "media",
      "sync": "remote"
    },
    "documents": {
      "group": "family",
      "symlinks": ["/home/alice/Documents"]
    },
    "archive": {
      "group": "family"
    }
  },
  "permissions": {
    "documents": { "user": "alice", "mode": "0755" }
  },
  "backup": {
    "enable": true,
    "keep": "1y",
    "stores": { "archive": false }
  }
}